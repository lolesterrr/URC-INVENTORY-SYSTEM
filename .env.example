# Copy to .env and adjust. All values are optional; defaults are shown.

# production | development
NODE_ENV=production

# 0.0.0.0 = reachable from other computers on the LAN
HOST=0.0.0.0
PORT=3000

# Folder for the SQLite database. Use a path OUTSIDE the application folder on the server,
# e.g. C:\URC-Inventory\storage
DATA_DIR=./storage
# DB_FILE=C:\URC-Inventory\storage\inventory.db

# HTTPS: set both to the certificate and key files from URC IT (PEM format).
# TLS_CERT_FILE=C:\URC-Inventory\certs\inventory.crt
# TLS_KEY_FILE=C:\URC-Inventory\certs\inventory.key

# Sign users out after this many idle minutes, and after this many hours in any case.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Backups: a verified copy of the database every night at BACKUP_HOUR (server local time, 0-23).
# Default folder: <DATA_DIR>\backups. Keeps the newest backup of each of the last 7 days, 4 weeks and 12 months.
# BACKUP_DIR=C:\URC-Inventory\backups
# Optional second copy on another disk or a network share (the service account needs write access):
# BACKUP_COPY_DIR=\\fileserver\it-backups\urc-inventory
BACKUP_HOUR=2
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12
